@model IEnumerable<FinalsInteg.Models.Product>
@{ ViewData["Title"] = "Shop"; }

<div class="page-heading">
    <div><p class="eyebrow">CUSTOMER STORE</p><h1>Available products</h1><p class="text-muted">Browse products and complete a purchase.</p></div>
</div>

@if (TempData["Success"] is not null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] is not null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<div class="content-card">
    <form class="search-bar mb-3" method="get">
        <input name="search" class="form-control" placeholder="Search products or categories..." value="@ViewBag.Search" />
        <button class="btn btn-dark">Search</button>
    </form>

    <div class="row g-3">
        @foreach (var product in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="content-card h-100">
                    <span class="tag">@product.Category</span>
                    <h3 class="mt-3">@product.Name</h3>
                    <p class="text-muted mb-2">@product.Supplier</p>
                    <h4>₱@product.Price.ToString("N2")</h4>
                    <form asp-action="Purchase" method="post" class="mt-3">
                        <input type="hidden" name="productId" value="@product.ProductId" />
                        <div class="mb-2">
                            <label class="form-label" for="customerName-@product.ProductId">Customer name</label>
                            <input id="customerName-@product.ProductId" name="customerName" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="quantity-@product.ProductId">Quantity</label>
                            <input id="quantity-@product.ProductId" name="quantity" type="number" min="1" value="1" class="form-control" required />
                        </div>
                        <button class="btn btn-primary w-100">Purchase</button>
                    </form>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">No matching products are currently available.</div>
    }
</div>
