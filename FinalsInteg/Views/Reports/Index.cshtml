@model IEnumerable<FinalsInteg.Models.Transaction>
@{ ViewData["Title"] = "Reports"; }
<div class="page-heading"><div><p class="eyebrow">BUSINESS INSIGHTS</p><h1>Sales reports</h1><p class="text-muted">A clear snapshot of transaction performance.</p></div><button class="btn btn-outline-dark" onclick="window.print()">Print report</button></div><div class="row g-3 mb-4"><div class="col-md-4"><div class="stat-card"><p>Total revenue</p><h2>₱@(((decimal)ViewBag.Revenue).ToString("N2"))</h2></div></div><div class="col-md-4"><div class="stat-card"><p>Units sold</p><h2>@ViewBag.Units</h2></div></div><div class="col-md-4"><div class="stat-card"><p>Sales records</p><h2>@Model.Count()</h2></div></div></div><div class="content-card"><div class="section-heading"><div><p class="eyebrow">TOP PRODUCTS</p><h3>Best performers</h3></div></div><div class="table-responsive"><table class="table"><thead><tr><th>Product</th><th>Units sold</th><th class="text-end">Revenue</th></tr></thead><tbody>@foreach (var item in ViewBag.TopProducts) { <tr><td class="fw-semibold">@item.Name</td><td>@item.Units</td><td class="text-end">₱@item.Revenue.ToString("N2")</td></tr>}</tbody></table></div></div>