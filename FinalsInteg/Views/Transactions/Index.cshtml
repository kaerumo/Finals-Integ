@model IEnumerable<FinalsInteg.Models.Transaction>
@{ ViewData["Title"] = "Transactions"; }
<div class="page-heading"><div><p class="eyebrow">SALES LEDGER</p><h1>Transactions</h1><p class="text-muted">Search and manage every recorded sale.</p></div><a class="btn btn-primary" asp-action="Create">+ Record sale</a></div>
@if (TempData["Success"] is not null) { <div class="alert alert-success">@TempData["Success"]</div> }<div class="content-card"><form class="search-bar mb-3" method="get"><input name="search" class="form-control" placeholder="Search customer or product..." value="@Context.Request.Query["search"]" /><button class="btn btn-dark">Search</button></form><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Customer</th><th>Product</th><th>Qty</th><th>Payment</th><th>Date</th><th class="text-end">Total</th><th></th></tr></thead><tbody>@foreach (var t in Model) { <tr><td class="fw-semibold">@t.CustomerName</td><td>@t.Product?.Name</td><td>@t.Quantity</td><td><span class="tag">@t.PaymentMethod</span></td><td>@t.TransactionDate.ToString("MMM dd, yyyy")</td><td class="text-end fw-semibold">₱@t.TotalAmount.ToString("N2")</td><td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@t.TransactionId">Edit</a><form asp-action="Delete" asp-route-id="@t.TransactionId" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this transaction?')">Delete</button></form></td></tr> }</tbody></table></div></div>