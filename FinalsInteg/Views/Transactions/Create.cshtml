@model FinalsInteg.Models.Transaction
@{ ViewData["Title"] = "Record Sale"; }
<div class="page-heading"><div><p class="eyebrow">SALES LEDGER</p><h1>Record a sale</h1><p class="text-muted">StockFlow will calculate the total and reduce inventory automatically.</p></div></div><div class="content-card form-card"><form asp-action="Create"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="CustomerName" class="form-label"></label><input asp-for="CustomerName" class="form-control" /><span asp-validation-for="CustomerName" class="text-danger"></span></div><div class="col-md-6"><label asp-for="ProductId" class="form-label">Product</label><select asp-for="ProductId" class="form-select"><option value="">Choose a product...</option>@foreach (var p in (IEnumerable<FinalsInteg.Models.Product>)ViewBag.Products) { <option value="@p.ProductId">@p.Name — ₱@p.Price.ToString("N2") (@p.StockQuantity left)</option> }</select><span asp-validation-for="ProductId" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Quantity" class="form-label"></label><input asp-for="Quantity" class="form-control" /><span asp-validation-for="Quantity" class="text-danger"></span></div><div class="col-md-4"><label asp-for="PaymentMethod" class="form-label">Payment method</label><select asp-for="PaymentMethod" class="form-select"><option>Cash</option><option>GCash</option><option>Card</option><option>Bank transfer</option></select></div><div class="col-md-4"><label asp-for="TransactionDate" class="form-label">Date</label><input asp-for="TransactionDate" class="form-control" /><span asp-validation-for="TransactionDate" class="text-danger"></span></div></div><hr class="my-4" /><button class="btn btn-primary">Save transaction</button> <a class="btn btn-light" asp-action="Index">Cancel</a></form></div>