@model FinalsInteg.Models.Transaction
@{ ViewData["Title"] = "Edit Transaction"; }
<div class="page-heading"><div><p class="eyebrow">SALES LEDGER</p><h1>Edit transaction</h1><p class="text-muted">Correct the record and save your changes.</p></div></div><div class="content-card form-card"><form asp-action="Edit"><input type="hidden" asp-for="TransactionId" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="CustomerName" class="form-label"></label><input asp-for="CustomerName" class="form-control" /></div><div class="col-md-6"><label asp-for="ProductId" class="form-label">Product</label><select asp-for="ProductId" class="form-select">@foreach (var p in (IEnumerable<FinalsInteg.Models.Product>)ViewBag.Products) { <option value="@p.ProductId">@p.Name</option> }</select></div><div class="col-md-4"><label asp-for="Quantity" class="form-label"></label><input asp-for="Quantity" class="form-control" /></div><div class="col-md-4"><label asp-for="PaymentMethod" class="form-label"></label><select asp-for="PaymentMethod" class="form-select"><option>Cash</option><option>GCash</option><option>Card</option><option>Bank transfer</option></select></div><div class="col-md-4"><label asp-for="TransactionDate" class="form-label"></label><input asp-for="TransactionDate" class="form-control" /></div></div><hr class="my-4" /><button class="btn btn-primary">Save changes</button> <a class="btn btn-light" asp-action="Index">Cancel</a></form></div>